  PROC main()
    ! Step 1: move to home
    MoveAbsJ home_jt, v_slow, fine, tool0\WObj:=wobj0;
    WaitTime 1;

    ! Step 2: move to start of trajectory
    MoveAbsJ jt00000, v_slow, fine, tool0\WObj:=wobj0;
    WaitTime 0.5;

    ! Step 3: execute trajectory
    ! Dense MoveAbsJ sequence at 20 Hz
    ! z1 blend zone ensures smooth continuous motion
    ! The actual velocity profile is defined by the
    ! waypoint spacing — TOPP-RA already respects joint limits.
