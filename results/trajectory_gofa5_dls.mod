  PROC main()
    ! Step 1: move to home
    MoveAbsJ home_jt, v_slow, fine, tool0\WObj:=wobj0;
    WaitTime 1;

    ! Step 2: move to start of trajectory (slow, exact stop)
    MoveAbsJ jt00000, v_slow, fine, tool0\WObj:=wobj0;
    WaitTime 0.5;

